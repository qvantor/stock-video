{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "src/test/**"
  ],
  "references": [
    {
      "path": "../../libs/api/video-analysis/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/contracts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/ffmpeg/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/geo/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/tech-analysis/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/llm/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/stock-csv/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/export-pipeline/tsconfig.lib.json"
    }
  ]
}
