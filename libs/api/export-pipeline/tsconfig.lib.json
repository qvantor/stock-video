{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../tech-analysis/tsconfig.lib.json"
    },
    {
      "path": "../stock-csv/tsconfig.lib.json"
    },
    {
      "path": "../llm/tsconfig.lib.json"
    },
    {
      "path": "../geo/tsconfig.lib.json"
    },
    {
      "path": "../ffmpeg/tsconfig.lib.json"
    },
    {
      "path": "../../shared/contracts/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test/**"
  ]
}
